# Benchmark: Generator throughput with 10 local variables.
# Stress-tests emitGenSaveVars / emitGenRestoreVars (Optimization 1).

define gen_loop(n: int) -> int:
    a = 0
    b = 0
    c = 0
    d = 0
    e = 0
    f = 0
    g = 0
    h = 0
    i = 0
    total = 0
    k = 0
    while k < n:
        yield total
        total = total + 1
        k = k + 1
    return 0

define main() -> void:
    n = 2000000
    gen = gen_loop(n)
    sum = 0
    for x in gen:
        sum = sum + x
    println("gen sum: " + str(sum))
